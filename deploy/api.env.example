# /etc/swahilichess/api.env, read by the four collector services.
# Create it once on the server: owner root, group the deploy user, mode 640.
# Use the same database as swahilichess-api.service.
SW_DB_DSN=postgres://USER:PASSWORD@127.0.0.1:5432/DATABASE?sslmode=disable
# Lichess personal token with team:read, from an account that administers Nyumbani Mates.
LICHESS_TOKEN=
